{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moader-community",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "moader.timsfun.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moader-community-catalog",
      "database_id": "247b8fc5-2ee4-456d-abc2-9284e608868b",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://moader.timsfun.com",
    "SUPABASE_URL": "https://impsxxsbfqywlatxbmvb.supabase.co",
    "BUCKET": "moader-community-files",
  },
  "triggers": { "crons": ["17 * * * *"] },
}
